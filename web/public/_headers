# Netlify response headers (https://docs.netlify.com/routing/headers/).

# Archived logos are third-party SVGs: never let one run scripts if opened directly.
/assets/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src data:

# Next's hashed bundles never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Machine-readable editions.
/*/llms.txt
  Content-Type: text/plain; charset=utf-8
/*/lore.md
  Content-Type: text/markdown; charset=utf-8

# Share images and the touch icon are written without an extension: say they're PNGs.
/opengraph-image-*
  Content-Type: image/png
/*/opengraph-image-*
  Content-Type: image/png
/*/*/opengraph-image-*
  Content-Type: image/png
/apple-icon
  Content-Type: image/png
